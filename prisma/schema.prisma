generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["multiSchema"]
  binaryTargets   = ["native", "darwin-arm64", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["sewadal"]
}

model Member {
  id                    Int      @id @default(autoincrement())
  fullName              String
  preferredName         String?
  gender                String?
  dateOfBirth           DateTime
  nationalIdType        String
  nationalIdNumber      String?
  photoUrl              String?

  email                 String?  @unique
  phonePrimary          String
  phoneSecondary        String?
  address               String
  city                  String
  stateRegion           String
  postalCode            String?
  country               String
  emergencyContactName  String?
  emergencyContactPhone String?

  unit                  String
  unitAssignedDate      DateTime
  role                  String?
  sewaRole              String   @default("Sewadal")
  registryStatus        String   @default("Registered")
  fatherHusbandName     String?
  qualification         String?
  profession            String?
  skills                String?
  bloodGroup            String?
  identityDocUrl        String?
  unitHistory           UnitAssignmentLog[]
  attendance            AttendanceRecord[]

  registrationDate      DateTime
  membershipStatus      String   @default("Active")
  statusEffectiveDate   DateTime
  lastRenewalDate       DateTime?
  notes                 String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@schema("sewadal")
}

model UnitAssignmentLog {
  id        Int       @id @default(autoincrement())
  memberId  Int
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  unit      String
  startDate DateTime
  endDate   DateTime?

  @@index([memberId])
  @@schema("sewadal")
}

model AttendanceRecord {
  id        Int      @id @default(autoincrement())
  memberId  Int
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  date      DateTime
  status    String
  notes     String?
  markedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, date])
  @@index([date])
  @@index([memberId])
  @@schema("sewadal")
}

model AttendanceSession {
  id            Int      @id @default(autoincrement())
  date          DateTime @unique
  topic         String?
  sanchalanSewa String?
  stageSewa     String?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@schema("sewadal")
}

model AppUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@schema("sewadal")
}

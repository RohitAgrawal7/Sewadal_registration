# =============================================================================
# Local development (.env) — copy to .env and fill values
# =============================================================================

PORT=3000
NODE_ENV=development

# =============================================================================
# Vercel → Project → Settings → Environment Variables
# Add each variable for: Production + Preview (+ Development if used)
# Turn ON "Available at Build Time" for DATABASE_URL
# After saving, Redeploy the project
# =============================================================================

# --- REQUIRED on Vercel -------------------------------------------------------

# Supabase Postgres connection string (Transaction pooler / Mode: Transaction)
# Supabase → Project Settings → Database → Connection string → URI
# Use the pooler host (port 6543) for Vercel serverless.
# Encode special characters in the password (@ → %40, # → %23, etc.)
# Example:
# DATABASE_URL="postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DATABASE_URL=

# Login username (app creates/finds this user on first login)
AUTH_USERNAME=Sewadal2026

# Login password (plain text here; stored hashed in DB)
AUTH_PASSWORD=

# Session signing secret — long random string (min ~32 characters)
# Generate: openssl rand -base64 48
# SESSION_SECRET is preferred; AUTH_SECRET is accepted as fallback
SESSION_SECRET=
AUTH_SECRET=

# --- OPTIONAL / local only (not required on Vercel) ---------------------------

# Local upload folder (Vercel uses ephemeral FS; prefer external storage later)
UPLOAD_PATH=./uploads

# Unused by this Next.js app (legacy / other tools)
CORS_ORIGIN=http://localhost:5173

PORT=3000
NODE_ENV=development

# Supabase Postgres (Transaction pooler recommended for serverless / Vercel).
# Encode special chars in password (e.g. @ → %40).
# Tables live in schema "sewadal" (does not touch other public tables).
#
# Vercel: Project → Settings → Environment Variables
# - Add DATABASE_URL for Production AND Preview
# - Enable "Available at Build Time"
# - Redeploy after saving
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&sslmode=require"

UPLOAD_PATH=./uploads
CORS_ORIGIN=http://localhost:5173

# Login credentials (set the same names on Vercel)
AUTH_USERNAME=Sewadal2026
AUTH_PASSWORD=
AUTH_SECRET=
SESSION_SECRET=
